{
  "name": "reef-patterns",
  "private": true,
  "version": "0.1.0",
  "description": "Learn 52 design patterns for frontend developers with JavaScript examples and interactive challenges that run in the browser.",
  "keywords": [
    "design-patterns",
    "javascript",
    "frontend",
    "react",
    "typescript",
    "gang-of-four",
    "learning",
    "coding-challenges"
  ],
  "homepage": "https://mtorre4580.github.io/reef-patterns/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtorre4580/reef-patterns.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "media": "tsx scripts/capture-media.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.77.0",
    "monaco-editor": "^0.57.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8",
    "vitest": "^5.1.0"
  }
}
